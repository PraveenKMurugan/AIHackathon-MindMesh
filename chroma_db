import chromadb
import os

VECTOR_DB_PATH = "./vector_db"

client = chromadb.PersistentClient(path=VECTOR_DB_PATH)

collection = client.get_or_create_collection(
    name="confluence_embeddings",
    metadata={"hnsw:space": "cosine"}   # cosine similarity (best for MiniLM)
)


def store_embeddings(chunks, embeddings, metadatas):
    ids = [f"doc_{i}" for i in range(len(chunks))]

    collection.add(
        ids=ids,
        documents=chunks,
        embeddings=embeddings,
        metadatas=metadatas
    )

    print(f"Stored {len(chunks)} chunks in vector DB")


def search_knowledge_base(query_embedding, top_k=5):
    return collection.query(
        query_embeddings=[query_embedding],
        n_results=top_k
    )


